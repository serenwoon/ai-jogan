<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ mail_title }} 지난 호</title>
<style>
  body { margin: 0; background: #fff; color: #222; font-family: -apple-system, BlinkMacSystemFont, "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; font-size: 15px; line-height: 1.7; }
  .page { max-width: 680px; margin: 0 auto; padding: 20px 16px 40px; }
  a { color: #1a4fd6; text-decoration: underline; }
  h1 { font-size: 20px; font-weight: 800; border-bottom: 3px double #222; padding-bottom: 4px; margin: 0 0 10px; }
  .sub { font-size: 12px; color: #888; margin: 0 0 12px; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { border-bottom: 1px solid #e3e3e3; padding: 8px 0; }
  .date { display: inline-block; min-width: 86px; font-size: 13px; color: #888; }
</style>
</head>
<body>
<div class="page">
<h1>{{ mail_title }}</h1>
<p class="sub">최근 {{ entries|length }}호</p>
<ul>
{% for e in entries %}<li><span class="date">{{ e.label }}</span><a href="{{ e.date }}/index.html">{{ e.headline }}</a></li>
{% endfor %}</ul>
</div>
</body>
</html>
