<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ v.page_title }}</title>
<meta name="description" content="{{ v.item.summary }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ v.item.title }}">
<meta property="og:description" content="{{ v.item.summary }}">
<meta property="og:url" content="{{ v.page_url }}">
{% if v.image %}<meta property="og:image" content="{{ v.image }}">
{% endif %}
<meta name="referrer" content="no-referrer">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23a8432a'/%3E%3Ctext x='16' y='23' font-size='18' text-anchor='middle' fill='%23fffdf8' font-family='serif'%3E%EC%A1%B0%3C/text%3E%3C/svg%3E">
<style>
  :root {
    --bg: #f2efe8; --paper: #fffdf8; --ink: #1f1d1a; --text: #3f3b35; --muted: #8b8478;
    --rule: #e7e1d6; --accent: #a8432a; --tint: #f5efe3;
    --sans: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", Pretendard, "Malgun Gothic", sans-serif;
    --serif: "Noto Serif KR", "Nanum Myeongjo", AppleMyungjo, Batang, Georgia, serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #161513; --paper: #1d1c19; --ink: #f1ece3; --text: #d6d0c5; --muted: #958e82;
            --rule: #34312c; --accent: #e07a5c; --tint: #27241f; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 16px; line-height: 1.8; -webkit-text-size-adjust: 100%; }
  a { color: inherit; }
  .page { max-width: 680px; margin: 0 auto; background: var(--paper); min-height: 100vh; padding: 0 0 48px; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 18px 24px 14px; border-bottom: 3px double var(--ink); }
  .brand { font-family: var(--serif); font-size: 20px; font-weight: 700; color: var(--ink); text-decoration: none; letter-spacing: -0.5px; }
  .date { font-size: 13px; color: var(--muted); text-decoration: none; }
  .date:hover, .brand:hover { color: var(--accent); }
  article { padding: 0 24px; }
  .kicker { margin: 28px 0 0; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; color: var(--accent); }
  h1 { font-family: var(--serif); font-size: clamp(24px, 6vw, 32px); line-height: 1.35; font-weight: 700; color: var(--ink); letter-spacing: -0.8px; margin: 10px 0 0; text-wrap: balance; word-break: keep-all; }
  .tags { margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { font-size: 12px; line-height: 1.7; color: var(--muted); background: var(--bg); padding: 0 8px; }
  .lead { font-size: 18px; line-height: 1.7; color: var(--ink); margin: 18px 0 0; word-break: keep-all; }
  figure { margin: 24px -24px 0; }
  figure img { display: block; width: 100%; height: auto; background: var(--tint); }
  .body { margin: 26px 0 0; }
  p { margin: 0; white-space: pre-line; word-break: keep-all; }
  h2 { font-family: var(--serif); font-size: 19px; color: var(--ink); margin: 34px 0 8px; letter-spacing: -0.3px; }
  .work { margin: 34px 0 0; background: var(--tint); padding: 18px 20px; }
  .work h2, .note h2 { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.5px; color: var(--accent); margin: 0 0 6px; }
  .lesson { margin: 34px 0 0; border-left: 3px solid var(--accent); padding: 2px 0 2px 18px; }
  .lesson h2 { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.5px; color: var(--accent); margin: 0 0 6px; }
  .lesson p { font-family: var(--serif); font-size: 18px; line-height: 1.7; color: var(--ink); }
  .note { margin: 34px 0 0; border-top: 1px solid var(--rule); padding: 16px 0 0; }
  .note h2 { color: var(--muted); }
  .note p { font-size: 14px; color: var(--muted); }
  .sources { margin: 34px 0 0; border-top: 1px solid var(--rule); padding: 16px 0 0; }
  .sources h2 { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.5px; color: var(--muted); margin: 0 0 6px; }
  .sources ul { margin: 0; padding: 0; list-style: none; }
  .sources li { padding: 6px 0; }
  .sources a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px; }
  .sources a:hover { text-decoration-color: var(--accent); }
  .host { display: block; font-size: 12px; color: var(--muted); }
  nav.more { margin: 40px 24px 0; border-top: 3px double var(--ink); padding: 14px 0 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  nav.more a { text-decoration: none; display: block; }
  nav.more small { display: block; font-size: 12px; color: var(--muted); }
  nav.more span { font-family: var(--serif); font-weight: 700; color: var(--ink); line-height: 1.5; }
  nav.more a:hover span { color: var(--accent); }
  nav.more .next { text-align: right; grid-column: 2; }
  .foot { margin: 28px 24px 0; font-size: 13px; color: var(--muted); }
  .foot a { color: var(--muted); }
  @media (min-width: 700px) { .page { margin-top: 24px; min-height: 0; } figure { margin: 24px 0 0; } }
</style>
</head>
<body>
<div class="page">
<header class="top">
<a class="brand" href="index.html">{{ v.mail_title }}</a>
<a class="date" href="index.html">{{ v.long_label }}</a>
</header>
<article>
<div class="kicker">{{ v.corner_label }}</div>
<h1>{{ v.item.title }}</h1>
{% if v.item.tags %}<div class="tags">{% for t in v.item.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
<p class="lead">{{ v.item.summary }}</p>
{% if v.image %}<figure><img src="{{ v.image }}" alt="{{ v.item.title }}" loading="lazy" referrerpolicy="no-referrer"></figure>
{% endif %}
<div class="body">
{% if v.blocks.what %}<p>{{ v.blocks.what.text }}</p>
{% endif %}
{% if v.blocks.why_now %}<h2>{{ v.blocks.why_now.heading }}</h2>
<p>{{ v.blocks.why_now.text }}</p>
{% endif %}
</div>
{% if v.blocks.use_at_work %}<section class="work"><h2>{{ v.blocks.use_at_work.heading }}</h2><p>{{ v.blocks.use_at_work.text }}</p></section>
{% endif %}
{% if v.blocks.lesson %}<section class="lesson"><h2>{{ v.blocks.lesson.heading }}</h2><p>{{ v.blocks.lesson.text }}</p></section>
{% endif %}
{% if v.blocks.caution %}<section class="note"><h2>{{ v.blocks.caution.heading }}</h2><p>{{ v.blocks.caution.text }}</p></section>
{% endif %}
<section class="sources"><h2>원문</h2>
<ul>
{% for src in v.item.sources %}<li>{% if src.url %}<a href="{{ src.url }}">{{ src.title }}</a><span class="host">{{ src.host }}</span>{% else %}{{ src.title }}{% endif %}</li>
{% endfor %}</ul>
</section>
</article>
{% if v.prev or v.next %}<nav class="more">
{% if v.prev %}<a href="{{ v.prev.url }}"><small>← 앞 기사</small><span>{{ v.prev.title }}</span></a>{% endif %}
{% if v.next %}<a class="next" href="{{ v.next.url }}"><small>다음 기사 →</small><span>{{ v.next.title }}</span></a>{% endif %}
</nav>
{% endif %}
<div class="foot"><a href="index.html">{{ v.label }} 호 전체</a> · <a href="../index.html">지난 호 모두 보기</a></div>
</div>
</body>
</html>
